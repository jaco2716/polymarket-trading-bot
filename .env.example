# ── Required ──────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Budget ────────────────────────────────────────────────
STARTING_BUDGET="500"
SHADOW_STARTING_BUDGET="1000" # separate budget for shadow/paper trades; defaults to STARTING_BUDGET if unset
TRADE_SIZE_PCT="0.05"
MIN_TRADE_USDC="5"

# ── Market filters ────────────────────────────────────────
MIN_LIQUIDITY="2000"
MIN_TRADE_PRICE="0.30"  # skip very cheap markets (data shows 0% win rate below 0.30)
MAX_TRADE_PRICE="0.85"  # skip near-certain outcomes; enforces both sides into [0.15, 0.85]
MAX_RESOLVE_HOURS="48"              # 0 means no limit; 48 = only markets resolving within 2 days
MAX_WHALE_RESOLVE_HOURS="120"       # 5 days — keeps positions turning over, avoids long-dated holds
MARKET_POOL_SIZE="300"
MARKETS_PER_SCAN="40"

# ── Strategies ────────────────────────────────────────────
ENABLE_HAIKU="true"
ENABLE_WHALE_COPY="true"
HAIKU_MIN_CONF="0.50"         # 0.50-0.54 is the sweet spot from shadow data (86.7% win rate)
SHADOW_HAIKU_MIN_CONF="0.45"  # lower threshold for shadow data collection
CONF_FLOOR="0.45"             # lowest confidence accepted (for low-price/high-payout markets)
SIZE_FLOOR="0.5"              # min trade size fraction (for low-price markets, 0.5 = half size)
HAIKU_SKIP_SPORTS="true"      # skip live game matchups/spreads (Haiku has no real-time sports data)
WHALE_MIN_SIZE="300"          # min USD size to consider a whale trade
MAX_WHALE_TRADES_PER_SCAN="5" # cap on whale trades placed per scan (safety limit)
WHALE_LEADERBOARD_SIZE="25"   # how many top wallets to fetch from leaderboard
WHALE_WALLETS_PER_SCAN="25"   # how many wallets to query for positions each scan — set equal to WHALE_LEADERBOARD_SIZE to scan all
# WHALE_WALLETS="0xabc123...,0xdef456..."

# ── Operational ───────────────────────────────────────────
MAX_OPEN_TRADES="50"
SCAN_INTERVAL="1800"

# ── Strategy mode ─────────────────────────────────────────
# compete  = paper trades; whale and haiku run independently each scan
# shadow   = no real trades; logs hypothetical trades for both strategies risk-free
# live     = REAL trades on Polymarket via CLOB API (requires private key)
STRATEGY_MODE="compete"

# Shadow scan interval (seconds) — only active in shadow mode.
# Lower than SCAN_INTERVAL to collect training data faster.
# 900 = 15 min (~$12/mo),  600 = 10 min (~$18/mo),  300 = 5 min (~$36/mo)
SHADOW_SCAN_INTERVAL="900"

# ── Live trading (real money) ────────────────────────────
# Set STRATEGY_MODE="live" and configure these to trade with real funds.
# Requires an EOA wallet with USDC on Polygon and approved token allowances.
# POLYMARKET_PRIVATE_KEY="0x..."       # Ethereum private key (Polygon/EOA)
# POLYMARKET_FUNDER_ADDRESS=""         # Optional — for proxy wallets only
# MAX_LIVE_TRADE_USDC="50"            # Hard cap per trade in USDC
# LIVE_MAX_OPEN_TRADES="5"            # Max concurrent live trades
# LIVE_DRY_RUN="true"                 # Log orders without placing (disable with "false")
