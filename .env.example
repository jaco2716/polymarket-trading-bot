# ── Required ──────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Budget ────────────────────────────────────────────────
STARTING_BUDGET="500"
TRADE_SIZE_PCT="0.03"
MIN_TRADE_USDC="5"

# ── Market filters ────────────────────────────────────────
MIN_LIQUIDITY="2000"
PRICE_MIN="0.10"
PRICE_MAX="0.90"
MARKETS_PER_SCAN="30"

# ── Strategies ────────────────────────────────────────────
ENABLE_HAIKU="true"
ENABLE_WHALE_COPY="true"
HAIKU_MIN_CONF="0.65"
SHADOW_HAIKU_MIN_CONF="0.35"
WHALE_MIN_SIZE="500"
WHALE_LOOKBACK_MIN="30"
# WHALE_WALLETS="0xabc123...,0xdef456..."

# ── Operational ───────────────────────────────────────────
MAX_OPEN_TRADES="10"
SCAN_INTERVAL="3600"

# ── Strategy mode ─────────────────────────────────────────
# compete  = strategies share 3 slots per scan (default)
# parallel = each strategy places real trades independently
# shadow   = no real trades; logs hypothetical trades for all 3
#            strategies so you can compare them risk-free
STRATEGY_MODE="compete"

# Shadow scan interval (seconds) — only active in shadow mode.
# Lower than SCAN_INTERVAL to collect training data faster.
# 900 = 15 min (~$12/mo),  600 = 10 min (~$18/mo),  300 = 5 min (~$36/mo)
SHADOW_SCAN_INTERVAL="900"
